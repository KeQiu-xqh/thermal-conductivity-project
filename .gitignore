# Local experiment data and generated outputs
/data/raw/*
/data/derived/*
/outputs/preview/*
/outputs/figures/*
!/data/raw/.gitkeep
!/data/derived/.gitkeep
!/outputs/preview/.gitkeep
!/outputs/figures/.gitkeep

# Legacy root-level generated artifacts
/video
/video_preview.gif
/frames_compare.png
/center_temp_curve.png
/center_roi_curve.png
/hot_roi_curve.png
/training_data_output/

# Common generated files
*.dat
*.log
*.tmp
*.temp
*.zip
*.rar
*.tar.gz

# Common image exports
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.ico
*.svg
*.webp

# System junk
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc

# Local agent/config folders
/.codex/
/.superpowers/

# Keep local gitignore out of version control if untracked
/.gitignore
